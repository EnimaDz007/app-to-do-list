{
  "id": "/",
  "name": "Task Priority Mobile App",
  "short_name": "TaskPriority",
  "description": "Mobile-first iOS and Android productivity dashboard with Eisenhower matrix, daily timeline, PWA installability, and native app export package.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "fullscreen"
  ],
  "orientation": "portrait-primary",
  "background_color": "#f1f5f9",
  "theme_color": "#f1f5f9",
  "lang": "en",
  "dir": "auto",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "New Task",
      "short_name": "Add Task",
      "description": "Quickly create a new task in your priority matrix",
      "url": "/?action=new-task",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Priority Matrix",
      "short_name": "Matrix",
      "description": "Open the 4 quadrants matrix view",
      "url": "/?tab=matrix",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "prefer_related_applications": false
}
