<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <!-- ═══ HERO STATS ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <!-- Karma (left, hero) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨  KARMA"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:textColor="#99FFFFFF"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/widget_karma"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />

                <!-- 🆕 Level name + emoji -->
                <TextView
                    android:id="@+id/widget_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌱 Beginner"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:textColor="#C4B5FD"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Streak (right, secondary) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥  STREAK"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:textColor="#B3FB923C"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/widget_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0d"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FB923C"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Level progress bar -->
        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#A78BFA"
            android:progressBackgroundTint="#22FFFFFF" />

        <!-- ═══ DIVIDER ═══ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/widget_divider" />

        <!-- ═══ TASK ROWS ═══ -->

        <!-- Task 1 -->
        <LinearLayout
            android:id="@+id/widget_task_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/widget_task_bar_1"
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:background="#E11D48" />

            <TextView
                android:id="@+id/widget_task_text_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text=""
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#F1F5F9"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Task 2 -->
        <LinearLayout
            android:id="@+id/widget_task_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/widget_task_bar_2"
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:background="#4F46E5" />

            <TextView
                android:id="@+id/widget_task_text_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text=""
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#F1F5F9"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Task 3 -->
        <LinearLayout
            android:id="@+id/widget_task_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/widget_task_bar_3"
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:background="#059669" />

            <TextView
                android:id="@+id/widget_task_text_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text=""
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#F1F5F9"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Empty state -->
        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center"
            android:text="All clear ✨"
            android:textSize="13sp"
            android:textStyle="italic"
            android:textColor="#66FFFFFF"
            android:fontFamily="sans-serif"
            android:visibility="gone" />

        <!-- Spacer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <!-- ═══ ADD BUTTON ═══ -->
        <TextView
            android:id="@+id/widget_add_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="+  Quick add task"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/widget_add_btn" />
    </LinearLayout>
</FrameLayout>